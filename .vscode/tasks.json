{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build pipeline_debug",
            "type": "shell",
            "command": "clang++",
            "args": [
                "-std=c++17",
                "-g",
                "-O0",
                "-DPIPELINE_DEBUG",
                "-o",
                "${workspaceFolder}/examples/pipeline/pipeline_debug",
                "${workspaceFolder}/examples/pipeline/pipeline.cpp"
            ],
            "group": "build",
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "build pipeline_debug_O1",
            "type": "shell",
            "command": "clang++",
            "args": [
                "-std=c++17",
                "-g",
                "-O1",
                "-DPIPELINE_DEBUG",
                "-o",
                "${workspaceFolder}/examples/pipeline/pipeline_debug_O1",
                "${workspaceFolder}/examples/pipeline/pipeline.cpp"
            ],
            "group": "build",
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "build pipeline_debug_O2",
            "type": "shell",
            "command": "clang++",
            "args": [
                "-std=c++17",
                "-g",
                "-O2",
                "-DPIPELINE_DEBUG",
                "-o",
                "${workspaceFolder}/examples/pipeline/pipeline_debug_O2",
                "${workspaceFolder}/examples/pipeline/pipeline.cpp"
            ],
            "group": "build",
            "problemMatcher": ["$gcc"]
        }
    ]
}
